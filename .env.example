# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION - P2PRINT MARKETPLACE (Next.js App Router)
# -----------------------------------------------------------------------------
# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Clé publique anonyme Supabase (utilisable côté client / navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Clé Service Role Supabase (STRICTEMENT réservée au serveur / API routes / server actions)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
